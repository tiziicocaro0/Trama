#!/bin/sh
# Antes de cada push corre los mismos chequeos que el CI, pero solo
# para la parte del repo que cambió (ver scripts/verificar-ci.sh).

set -eu

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
cambia_backend=0
cambia_frontend=0
cambian_dependencias=0
desactualizadas=""

# Traer el develop actual del remoto: los tests tienen que probar la rama
# tal como quedaría al mergearse, no contra un develop viejo.
# Sin conexión no se bloquea el push (el CI lo va a revisar igual).
develop_al_dia=1
if command -v timeout >/dev/null 2>&1; then
    timeout 60 git fetch --quiet origin develop || develop_al_dia=0
else
    git fetch --quiet origin develop || develop_al_dia=0
fi
if [ "$develop_al_dia" -eq 0 ]; then
    echo "Aviso: no se pudo traer origin/develop; se verifica contra la última copia local."
fi

# Revisar todas las referencias que se intentan subir.
while read -r local_ref local_sha remote_ref remote_sha
do
    # Ignorar eliminaciones de ramas.
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi

    # Una rama de trabajo tiene que incluir todo develop. Si no, sus tests
    # no prueban lo que va a quedar después del merge.
    case "$remote_ref" in
        refs/heads/develop|refs/heads/main) ;;
        *)
            if ! git merge-base --is-ancestor origin/develop "$local_sha"; then
                atrasados=$(git rev-list --count "$local_sha..origin/develop")
                desactualizadas="$desactualizadas
  - ${remote_ref#refs/heads/}: le faltan $atrasados commit(s) de develop"
            fi
            ;;
    esac

    # Determinar los commits que se van a subir.
    if [ "$remote_sha" = "$zero" ]; then
        base=$(git merge-base "$local_sha" origin/develop 2>/dev/null || true)
    else
        base="$remote_sha"
    fi

    # Si no se puede determinar la base, verificar todo por seguridad.
    if [ -z "$base" ]; then
        cambia_backend=1
        cambia_frontend=1
        continue
    fi

    cambios=$(git diff --name-only "$base" "$local_sha")

    if printf '%s\n' "$cambios" | grep -q -E '^(backend/|\.github/)'; then
        cambia_backend=1
    fi
    if printf '%s\n' "$cambios" | grep -q -E '^(frontend/|\.github/)'; then
        cambia_frontend=1
    fi
    if printf '%s\n' "$cambios" | grep -q -E '^frontend/package(-lock)?\.json$'; then
        cambian_dependencias=1
    fi
done

if [ -n "$desactualizadas" ]; then
    echo "Push cancelado: la rama no está al día con develop.$desactualizadas"
    echo ""
    echo "Traé develop, resolvé los conflictos si hay y volvé a pushear:"
    echo "  git merge origin/develop"
    exit 1
fi

if [ "$cambia_backend" -eq 0 ] && [ "$cambia_frontend" -eq 0 ]; then
    echo "No hay cambios de backend ni de frontend pendientes de push."
    exit 0
fi

opciones=""
if [ "$cambia_backend" -eq 1 ]; then
    opciones="$opciones --backend"
fi
if [ "$cambia_frontend" -eq 1 ]; then
    opciones="$opciones --frontend"
fi
if [ "$cambian_dependencias" -eq 1 ]; then
    opciones="$opciones --npm-ci"
fi

echo "Verificando como el CI:$opciones"

# shellcheck disable=SC2086
sh scripts/verificar-ci.sh $opciones || {
    echo "Push cancelado: corregí lo que falló y volvé a pushear."
    exit 1
}

echo "Verificación correcta. Push permitido."
exit 0
