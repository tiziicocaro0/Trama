#!/bin/sh
# Antes de cada push corre los mismos chequeos que el CI, pero solo
# para la parte del repo que cambió (ver scripts/verificar-ci.sh).

set -eu

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
cambia_backend=0
cambia_frontend=0
cambian_dependencias=0

# Revisar todas las referencias que se intentan subir.
while read -r local_ref local_sha remote_ref remote_sha
do
    # Ignorar eliminaciones de ramas.
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi

    # Determinar los commits que se van a subir.
    if [ "$remote_sha" = "$zero" ]; then
        base=$(git merge-base "$local_sha" origin/develop 2>/dev/null || true)
    else
        base="$remote_sha"
    fi

    # Si no se puede determinar la base, verificar todo por seguridad.
    if [ -z "$base" ]; then
        cambia_backend=1
        cambia_frontend=1
        continue
    fi

    cambios=$(git diff --name-only "$base" "$local_sha")

    if printf '%s\n' "$cambios" | grep -q -E '^(backend/|\.github/)'; then
        cambia_backend=1
    fi
    if printf '%s\n' "$cambios" | grep -q -E '^(frontend/|\.github/)'; then
        cambia_frontend=1
    fi
    if printf '%s\n' "$cambios" | grep -q -E '^frontend/package(-lock)?\.json$'; then
        cambian_dependencias=1
    fi
done

if [ "$cambia_backend" -eq 0 ] && [ "$cambia_frontend" -eq 0 ]; then
    echo "No hay cambios de backend ni de frontend pendientes de push."
    exit 0
fi

opciones=""
if [ "$cambia_backend" -eq 1 ]; then
    opciones="$opciones --backend"
fi
if [ "$cambia_frontend" -eq 1 ]; then
    opciones="$opciones --frontend"
fi
if [ "$cambian_dependencias" -eq 1 ]; then
    opciones="$opciones --npm-ci"
fi

echo "Verificando como el CI:$opciones"

# shellcheck disable=SC2086
sh scripts/verificar-ci.sh $opciones || {
    echo "Push cancelado: corregí lo que falló y volvé a pushear."
    exit 1
}

echo "Verificación correcta. Push permitido."
exit 0
